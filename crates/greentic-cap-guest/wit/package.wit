package greentic:cap-runtime@1.0.0;

/// Provider-neutral invocation of a capability selected by trusted resolution.
interface capability-client {
    record request {
        binding-id: string,
        operation: string,
        payload-cbor: list<u8>,
    }

    record response {
        output-cbor: list<u8>,
        metadata-cbor: option<list<u8>>,
    }

    variant capability-error {
        binding-not-found,
        operation-not-allowed,
        provider-unavailable,
        invalid-input,
        invalid-output,
        policy-denied,
        timeout,
        cancelled,
        overloaded,
        protocol-error,
        internal,
    }

    invoke: func(request: request) -> result<response, capability-error>;
}

world capability-consumer {
    import capability-client;
}
